{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Peak",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "46rem", "wideSize": "68rem" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f4efe4" },
				{ "slug": "contrast", "name": "Ink", "color": "#2b2a26" },
				{ "slug": "primary", "name": "Moss", "color": "#3d5a3a" },
				{ "slug": "accent", "name": "Heather", "color": "#7a4a6e" },
				{ "slug": "muted", "name": "Stone", "color": "#6b665c" },
				{ "slug": "highlight", "name": "Gorse", "color": "#e7d7a3" }
			]
		},
		"custom": {
			"scheme": "light",
			"page-background": "#f4efe4",
			"grid": { "opacity": "0", "color": "#d3c8b0" },
			"grain": { "strength": "0.35", "blend": "multiply" },
			"hill": { "1": "#b8c7a4", "2": "#7f9a6c", "3": "#3d5a3a" },
			"valley": { "text": "#f4efe4", "accent": "#cbd8b0" },
			"sky": { "top": "#e9e4ea", "bottom": "#f4efe4", "sun": "#f2c98a" },
			"rider": {
				"lamp": "transparent",
				"glow": "transparent",
					"rear": "transparent",
					"rear-glow": "transparent"
			}
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "heading", "name": "Young Serif", "fontFamily": "\"Young Serif\", Georgia, serif",
					"fontFace": [ { "fontFamily": "Young Serif", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/young-serif-latin-400-normal.woff2" ] } ]
				},
				{
					"slug": "body", "name": "Newsreader", "fontFamily": "Newsreader, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-latin-wght-normal.woff2" ] },
						{ "fontFamily": "Newsreader", "fontWeight": "200 800", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/newsreader-latin-wght-italic.woff2" ] }
					]
				},
				{
					"slug": "ui", "name": "Inter", "fontFamily": "Inter, system-ui, sans-serif",
					"fontFace": [ { "fontFamily": "Inter", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ] } ]
				},
				{
					"slug": "mono", "name": "JetBrains Mono", "fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
					"fontFace": [ { "fontFamily": "JetBrains Mono", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/jetbrains-mono-latin-400-normal.woff2" ] } ]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.8125rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.25rem" } },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.5rem", "max": "3.75rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" },
				{ "slug": "70", "name": "XXL", "size": "6rem" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"spacing": {
			"padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" },
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "400", "lineHeight": "1.15" },
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "1.375rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			}
		},
		"blocks": {
			"core/post-date": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/post-terms": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "0.75rem", "textTransform": "uppercase", "letterSpacing": "0.06em" }
			},
			"core/navigation": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "0.9375rem" }
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "1rem", "fontWeight": "400" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--primary)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/query-title": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } }
		}
	},
	"customTemplates": [
		{ "name": "photos-grid", "title": "Photos grid", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "comments", "title": "Comments", "area": "uncategorized" }
	]
}
